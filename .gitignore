# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / OS
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# tooling caches
.turbo/
.eslintcache
*.log

# Generated placeholder imagery is COMMITTED on purpose, so a fresh clone runs
# without ffmpeg. If you swap in real photography and would rather keep it out of
# git, uncomment these — and remember `npm run assets` will not bring it back.
# /public/hero/sequence/
# /public/video/
